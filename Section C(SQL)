create or replace view purchase_order_summary as select po.po_id, s.supplier_name,p.part_name,poi.quantity,p.unit_price,poi.quantity*p.unit_price as line_total,
po.status
from purchase_orders as po join suppliers as s
on po.supplier_id=s.supplier_id
join purchase_order_items as poi on po.po_id=poi.po_id
join parts as p
on poi.part_id=p.part_id;

select*from purchase_order_summary where status='Pending';

create or replace function calculate_part_disscount(amount NUMERIC) returns NUMERIC LANGUAGE PLPGSQL
AS $$
BEGIN 
	if amount>=2000 then 
		return amount*0.10;
else
	return 0;
end if;
end;
$$;

select part_id,part_name,unit_price,calculate_part_disscount(unit_price)as discount from parts;

create or replace function
final_part_price(amount NUMERIC)
returns numeric
language plpgsql
as $$
begin
return amount-calculate_part_disscount(amount);
end;
$$;
select part_id, part_name,unit_price, final_part_price(unit_price)as final_price from parts;

create or replace procedure
update_po_status(in p_po_id int,in p_new_status varchar(30))
language plpgsql
as $$
begin 
update purchase_orders
set status=p_new_status
where purchase_orders.po_id=p_po_id;
end;
$$;

do $$
declare v_po_id int;
begin
select min(po_id)
into v_po_id
from purchase_orders;
if v_po_id is not null then call update_po_status(v_po_id,'Received');
end if;
end;
$$;

select * from purchase_orders order by po_id;

create or replace procedure
mark_old_pending_orders()
language plpgsql
as $$
begin update purchase_orders set status='Received' where status='Pending' and order_date<DATE '2026-10-04';
END;
$$;

call mark_old_pending_orders();
select*from purchase_orders where status='Received' order by order_date;

