\pard{\pntext\f3\'B7\tab}{\*\pn\pnlvlblt\pnf3\pnindent360{\pntxtb\'B7}}\widctlpar\fi-360\li720\sa160\sl360\slmult1\qj\ulnone\b0 GitHub Copilot\par
{\pntext\f3\'B7\tab}Microsoft Copilot\par
{\pntext\f3\'B7\tab}ChatGPT\par
{\pntext\f3\'B7\tab}Amazon CodeWhisperer\par
